*.zim
*.zim.prep/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Logs / state
*.log
log.jsonl
scripts/scrub-rules.local.txt
